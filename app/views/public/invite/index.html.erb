<main class="w-full min-h-[80%] flex items-center justify-center">
  <div class="w-full max-w-md mx-4 bg-white border border-gray-200 rounded-lg p-8">
    <header class="text-center mb-6">
      <div class="flex items-center justify-center gap-3">
        <div>
          <h1 class="text-2xl font-semibold text-gray-800">ユーザー招待</h1>
          <p class="text-sm text-gray-500">ユーザーを招待します</p>
        </div>
      </div>
    </header>

    <div>
      <% if @result == "failed" %>
        <%= render "shared/form_alert", color: "red", message: @message %>
      <% end %>
      <% if @result == "created" %>
        <%= render "shared/form_alert", color: "green", message: @message %>
      <% end %>

      <%= form_with url: "/api/invites", method: :post, local: true, html: { autocomplete: 'on' } do |form| %>
        <div class="mb-4">
          <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email, required: true, autofocus: true, placeholder: "you@example.com", aria: { describedby: 'email-help' }, autocomplete: 'email', class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-600" %>
          <p id="email-help" class="mt-1 text-xs text-gray-500">招待するユーザーのメールアドレスを入力してください。</p>
        </div>

        <div class="mb-4">
          <%= form.submit "招待", class: "w-full py-2 px-4 bg-blue-600 text-white rounded-md text-sm font-medium hover:opacity-95" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
